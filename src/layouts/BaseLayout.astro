---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MobileNavigation from "@/components/MobileNavigation.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import SEOHead from "@/components/SEOHead.astro";
import LocalBusinessSchema from "@/components/LocalBusinessSchema.astro";
import { withBase } from "@/lib/path";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
  hideStickyBar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  noindex,
  transparentHeader = false,
  hideStickyBar = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <script is:inline>
      /* Verhindert, dass der Browser beim Laden/Zurück-Navigieren eine
         frühere Scroll-Position automatisch wiederherstellt. Muss so früh
         wie möglich laufen, daher als erstes inline Skript im <head>.
         Betrifft nur die Browser-eigene History-Scroll-Restauration –
         gezielte #Anker-Links (z. B. #kontakt) funktionieren unverändert
         weiter, da diese vom Browser unabhängig davon behandelt werden. */
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      function simScrollTopIfNoHash() {
        if (!window.location.hash) {
          window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        }
      }
      simScrollTopIfNoHash();
      window.addEventListener("pageshow", simScrollTopIfNoHash);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07354a" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <SEOHead title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} />
    <LocalBusinessSchema />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Header transparentOnTop={transparentHeader} />
    <MobileNavigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {!hideStickyBar && <StickyMobileBar />}
    <script>
      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window && revealElements.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );
        revealElements.forEach((el) => observer.observe(el));
      } else {
        revealElements.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
