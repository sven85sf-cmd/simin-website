---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MobileNavigation from "@/components/MobileNavigation.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import SEOHead from "@/components/SEOHead.astro";
import LocalBusinessSchema from "@/components/LocalBusinessSchema.astro";
import { withBase, isPreviewBuild } from "@/lib/path";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
  hideStickyBar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  noindex,
  transparentHeader = false,
  hideStickyBar = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <script is:inline>
      /* Verhindert, dass der Browser beim Laden/Zurück-Navigieren eine
         frühere Scroll-Position automatisch wiederherstellt. Muss so früh
         wie möglich laufen, daher als erstes inline Skript im <head>.
         Betrifft nur die Browser-eigene History-Scroll-Restauration –
         gezielte #Anker-Links (z. B. #kontakt) funktionieren unverändert
         weiter, da diese vom Browser unabhängig davon behandelt werden. */
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      function simScrollTopIfNoHash() {
        if (!window.location.hash) {
          window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        }
      }
      simScrollTopIfNoHash();
      window.addEventListener("pageshow", simScrollTopIfNoHash);
    </script>
    <script is:inline>
      /* Setzt "motion-enabled" auf <html> SYNCHRON und VOR dem ersten
         Paint - deshalb hier im <head> als eigenständiges, blockierendes
         Inline-Skript, nicht im Skript am Body-Ende.
         Zuvor wurde diese Klasse erst am Body-Ende gesetzt, nachdem
         der Browser [data-reveal]-Elemente bereits sichtbar gemalt hatte
         (ohne motion-enabled greift keine opacity:0-Regel). Das erzeugte
         ein sichtbares Flackern: sichtbar -> (Klasse kommt spät) plötzlich
         unsichtbar -> nach Scroll-Trigger wieder animiert sichtbar. Mit der
         Klasse bereits vor dem ersten Paint gesetzt, ist der unsichtbare
         Ausgangszustand von Anfang an Teil des allerersten gemalten Frames
         - kein Umschalten mehr sichtbar -> unsichtbar.
         Das Skript am Body-Ende (siehe unten) setzt diese Klasse NICHT
         erneut; es kümmert sich nur noch um Stagger-Timing und das
         Sichtbar-Schalten ("is-visible") einzelner Elemente. */
      (function () {
        try {
          var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduceMotion) return;

          document.documentElement.classList.add("motion-enabled");

          /* Fail-Safe: Falls das Reveal-Skript am Body-Ende aus
             irgendeinem Grund nie läuft oder nie fertig wird (Fehler,
             blockiertes Skript, sehr langsames Netz), dürfen
             [data-reveal]-Elemente NIE dauerhaft unsichtbar bleiben.
             Das Body-Skript räumt diesen Timeout selbst auf, sobald es
             erfolgreich zu laufen beginnt. */
          window.__revealFailSafe = window.setTimeout(function () {
            document.documentElement.classList.add("reveal-fallback");
          }, 4000);
        } catch (e) {
          /* Bei jedem Fehler hier lieber motion-enabled gar nicht setzen -
             im Zweifel bleibt der Inhalt sofort sichtbar. */
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07354a" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <SEOHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex || isPreviewBuild()}
    />
    <LocalBusinessSchema />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Header transparentOnTop={transparentHeader} />
    <MobileNavigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {!hideStickyBar && <StickyMobileBar />}
    <script>
      /**
       * Zentrales Motion-/Reveal-System.
       *
       * Progressive Enhancement: [data-reveal]-Elemente sind ohne dieses
       * Skript und ohne CSS-Unterstützung ganz normal sichtbar (siehe
       * global.css - die unsichtbaren Ausgangszustände greifen erst unter
       * html.motion-enabled). Bei prefers-reduced-motion wird die Klasse
       * gar nicht erst gesetzt: keine Reveal-Sequenzen, Inhalt bleibt
       * sofort vollständig sichtbar und bedienbar.
       *
       * "motion-enabled" wird NICHT hier gesetzt, sondern bereits synchron
       * vor dem ersten Paint durch ein Inline-Skript im <head> (siehe
       * BaseLayout.astro-Kopf) - das verhindert das früher hier vorhandene
       * Flackern (sichtbar -> unsichtbar -> animiert sichtbar). Dieses
       * Skript liest die Klasse nur noch und kümmert sich um Stagger-Timing
       * und das Sichtbar-Schalten einzelner Elemente.
       */
      try {
        if (typeof (window as unknown as { __revealFailSafe?: number }).__revealFailSafe === "number") {
          window.clearTimeout((window as unknown as { __revealFailSafe?: number }).__revealFailSafe);
        }
      } catch {
        // Fail-Safe-Aufräumen ist rein defensiv - ein Fehler hier darf den
        // Rest des Reveal-Systems nicht verhindern.
      }

      const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        // Stagger: Kindelemente mit [data-reveal] innerhalb eines
        // [data-stagger]-Containers erhalten eine steigende Verzögerung
        // (Default 80ms, überschreibbar via data-stagger="120").
        document.querySelectorAll<HTMLElement>("[data-stagger]").forEach((group) => {
          const step = Number(group.dataset.stagger) || 80;
          const children = group.querySelectorAll<HTMLElement>(":scope > [data-reveal]");
          children.forEach((child, index) => {
            child.style.setProperty("--reveal-delay", String(index * step));
          });
        });

        // Der Hero ist grundsätzlich beim Laden bereits im Viewport - seine
        // Reveal-Sequenz ist eine Lade-Dramaturgie, kein Scroll-Reveal. Mit
        // dem gemeinsamen Scroll-Observer (rootMargin -10% unten) verpasst
        // ausgerechnet der Hero-CTA-Block (durch die bodenbündige Hero-
        // Ausrichtung nah am unteren Viewport-Rand positioniert) auf
        // vielen Bildschirmhöhen die Trigger-Zone dauerhaft und bliebe
        // unsichtbar. Deshalb bekommt der Hero eine eigene, sofortige
        // Reveal-Behandlung; alle übrigen Sektionen nutzen weiterhin einen
        // einzigen gemeinsamen Scroll-IntersectionObserver.
        const heroTargets = Array.from(document.querySelectorAll<HTMLElement>(".hero [data-reveal]"));
        const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]")).filter(
          (el) => !heroTargets.includes(el),
        );

        function startObserving() {
          heroTargets.forEach((el) => el.classList.add("is-visible"));

          if ("IntersectionObserver" in window && revealTargets.length) {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
            );
            revealTargets.forEach((el) => observer.observe(el));
          } else {
            revealTargets.forEach((el) => el.classList.add("is-visible"));
          }
        }

        // Der Browser muss den unsichtbaren Ausgangszustand (opacity:0,
        // siehe global.css) mindestens einmal gemalt haben, BEVOR
        // "is-visible" gesetzt wird - sonst verschmelzen beide Zustände in
        // einem Frame und Above-the-fold-Elemente (z. B. der Hero, dessen
        // IntersectionObserver-Callback praktisch sofort feuert) erscheinen
        // ohne jede sichtbare Animation. Ein doppeltes rAF bzw. ein
        // erzwungener Reflow reichen dafür nachweislich nicht zuverlässig
        // aus (der Browser kann Style-Berechnung und Paint weiterhin im
        // selben Frame zusammenfassen) - ein echtes Makrotask-Delay über
        // setTimeout garantiert dagegen einen abgeschlossenen Render-Zyklus
        // dazwischen. Sehr kurz gehalten, damit der Reveal nicht spürbar
        // verzögert wirkt.
        window.setTimeout(startObserving, 32);
      }
    </script>
  </body>
</html>
