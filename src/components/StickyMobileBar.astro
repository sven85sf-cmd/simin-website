---
import { company } from "@/config/site";
import { withBase } from "@/lib/path";
---

<div class="sticky-bar" id="sticky-mobile-bar">
  <a href={company.phone.href} class="sticky-bar__btn sticky-bar__btn--call">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"
        fill="currentColor"
      />
    </svg>
    ANRUFEN
  </a>
  <a href={withBase("/angebot")} class="sticky-bar__btn sticky-bar__btn--quote">ANGEBOT ANFRAGEN</a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    height: var(--sticky-bar-height);
    padding-bottom: env(safe-area-inset-bottom, 0);
    box-shadow: 0 -4px 16px rgba(7, 53, 74, 0.16);
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .sticky-bar.is-hidden {
    transform: translateY(100%);
  }

  .sticky-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    min-height: var(--sticky-bar-height);
  }

  .sticky-bar__btn--call {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .sticky-bar__btn--quote {
    background: var(--color-orange);
    color: var(--color-navy);
  }

  @media (min-width: 1200px) {
    .sticky-bar {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById("sticky-mobile-bar");
  const wizard = document.getElementById("angebotsassistent");

  if (bar && wizard && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          bar.classList.toggle("is-hidden", entry.isIntersecting);
        });
      },
      { rootMargin: "0px 0px -20% 0px" },
    );
    observer.observe(wizard);
  }
</script>
