---
import { withBase } from "@/lib/path";

const audiences = ["Hausverwaltungen", "Eigentümer", "Unternehmen"];
const objectTypes = ["Wohnanlagen", "Büro & Praxis", "Gewerbeimmobilien"];
---

<section class="business-section section--navy section">
  <div class="container business-section__grid">
    <div data-reveal="left">
      <p class="eyebrow eyebrow--orange-on-dark">FÜR IMMOBILIEN & VERWALTUNGEN</p>
      <h2 class="business-section__headline">
        EIN ANSPRECHPARTNER.<br />
        MEHRERE LEISTUNGEN.<br />
        WENIGER AUFWAND.
      </h2>
      <p class="business-section__text">
        Wer Immobilien betreut, braucht verlässliche Partner und klare Zuständigkeiten. SIMIN
        bündelt verschiedene Leistungen rund um gepflegte Gebäude und Außenanlagen – mit direkter
        Kommunikation und einem festen Ansprechpartner.
      </p>
      <p class="business-section__text">
        Ob einzelne Leistung oder abgestimmte Kombination: Der Umfang wird passend zum Objekt und
        zu Ihren Anforderungen vereinbart.
      </p>
      <div class="business-section__actions">
        <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
        <a href={withBase("/fuer-hausverwaltungen")} class="btn-ghost btn-ghost--on-dark">FÜR HAUSVERWALTUNGEN</a>
      </div>
    </div>

    <div class="business-section__lists" data-reveal="right">
      <div class="business-section__list-card">
        <h3>Für</h3>
        <ul>
          {audiences.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="business-section__list-card">
        <h3>Objekte</h3>
        <ul>
          {objectTypes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .business-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }

  .business-section__grid > * {
    min-width: 0;
  }

  .business-section__headline {
    font-size: var(--fs-h2);
    color: var(--color-white);
    margin-top: 14px;
  }

  .business-section__text {
    margin-top: 20px;
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.9);
  }

  .business-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
    align-items: center;
  }

  .business-section__lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-content: start;
  }

  .business-section__list-card {
    min-width: 0;
  }

  .business-section__list-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .business-section__list-card h3 {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-light-blue);
    margin-bottom: 14px;
  }

  .business-section__list-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-white);
    font-weight: 500;
  }

  @media (min-width: 420px) {
    .business-section__list-card {
      padding: 24px;
    }
  }

  @media (min-width: 640px) {
    .business-section__lists {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .business-section__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }
</style>
