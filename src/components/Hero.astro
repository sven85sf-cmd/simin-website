---
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import Logo from "@/components/Logo.astro";
import { withBase } from "@/lib/path";
---

<section class="hero">
  <div class="hero__media">
    <ResponsiveImage
      src="/images/hero-immobilie.webp"
      alt="Hochwertige, gepflegte Immobilie in Köln bei Herbst- und Winterwetter, betreut von Gebäudedienste SIMIN"
      width={1600}
      height={2244}
      loading="eager"
      fetchpriority="high"
      class="hero__image"
      fill
    />
    <div class="hero__gradient" aria-hidden="true"></div>
  </div>

  <div class="container hero__content" data-stagger="150">
    <Logo size="hero" variant="light" class="hero__logo" data-reveal="up" />
    <p class="eyebrow eyebrow--orange-on-dark hero__eyebrow" data-reveal="up">GEBÄUDEDIENSTE SIMIN · KÖLN</p>
    <h1 class="hero__headline" data-reveal="up">
      GEPFLEGTE IMMOBILIEN.<br />
      ALLES AUS EINER HAND.
    </h1>
    <p class="hero__text" data-reveal="up">
      Gebäudereinigung, Objektservice sowie Außenanlagen- und Winterdienst für Immobilien,
      Unternehmen und Verwaltungen in Köln und Umgebung.
    </p>
    <div class="hero__actions" data-reveal="up">
      <div class="hero__primary-action">
        <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
        <span class="micro-copy micro-copy--hero">Kostenlos & unverbindlich</span>
      </div>
      <a href="#leistungen" class="btn-ghost btn-ghost--on-dark hero__secondary">LEISTUNGEN ENTDECKEN</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 75svh;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  /* :global() nötig: .hero__image wird als class-Prop an ResponsiveImage
     durchgereicht, das <img> trägt also dessen data-astro-cid, nicht das
     von Hero.astro - ohne :global() würde Astros automatisches CSS-Scoping
     diese Selektoren nie treffen.
     Das Hero-Hintergrundbild ist bewusst vollständig statisch: keine
     Animation, kein transform, keine transition auf transform, kein
     will-change - siehe Auftrag "Hero-Hintergrundbild muss vollständig
     statisch sein". Eine frühere Cinematic-Zoom-Keyframe-Animation wurde
     hier entfernt. */
  :global(.hero__image) {
    height: 100%;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(7, 53, 74, 0.94) 0%,
      rgba(7, 53, 74, 0.75) 38%,
      rgba(7, 53, 74, 0.25) 68%,
      rgba(7, 53, 74, 0.05) 100%
    );
  }

  .hero__content {
    position: relative;
    width: 100%;
    min-width: 0;
    padding-block: clamp(48px, 10vh, 96px) clamp(56px, 12vh, 96px);
    max-width: 760px;
  }

  /* :global() nötig: .hero__logo wird als class-Prop an die Logo-
     Komponente durchgereicht, das Element trägt also deren data-astro-cid,
     nicht das von Hero.astro - ohne :global() träfen diese Selektoren nie
     (die Marken-spezifische Skalierung/Dauer lief dadurch nie, nur der
     globale Standard-Reveal aus global.css). */
  :global(.hero__logo) {
    margin-bottom: 22px;
  }

  /* Markenreveal: "Marke tritt ruhig ins Bild" - spürbarer Versatz und
     Skalierung, damit die Markeninszenierung tatsächlich wahrgenommen
     wird, aber weiterhin ruhig (kein "Reinfliegen"). */
  html.motion-enabled :global(.hero__logo[data-reveal]) {
    transform: scale(0.92) translateY(28px);
    transition-duration: 900ms;
  }

  html.motion-enabled :global(.hero__logo[data-reveal].is-visible) {
    transform: none;
  }

  .hero__eyebrow {
    margin-bottom: 18px;
  }

  .hero__headline {
    font-size: var(--fs-hero);
    color: var(--color-white);
    text-wrap: balance;
  }

  /* Headline bewegt sich sichtbar ins Bild - größerer Versatz als der
     Rest der Seite, da sie der dramaturgische Höhepunkt des Hero-Reveals
     ist. */
  html.motion-enabled .hero__headline[data-reveal] {
    transform: translateY(48px);
    transition-duration: 950ms;
  }

  html.motion-enabled .hero__headline[data-reveal].is-visible {
    transform: none;
  }

  .hero__text {
    margin-top: 24px;
    font-size: var(--fs-lead);
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 36px;
  }

  html.motion-enabled .hero__actions[data-reveal] {
    transform: translateY(27px);
    transition-duration: 800ms;
  }

  html.motion-enabled .hero__actions[data-reveal].is-visible {
    transform: none;
  }

  .hero__primary-action {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .micro-copy--hero {
    color: rgba(255, 255, 255, 0.75);
  }

  @media (min-width: 1200px) {
    .hero {
      min-height: 82svh;
    }
  }
</style>
