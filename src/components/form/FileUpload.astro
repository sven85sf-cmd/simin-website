---
import { ALLOWED_FILE_EXTENSIONS, MAX_FILES, MAX_FILE_SIZE_BYTES } from "@/lib/forms/types";

interface Props {
  id: string;
  name: string;
  label: string;
}

const { id, name, label } = Astro.props;
const maxSizeMb = Math.round(MAX_FILE_SIZE_BYTES / (1024 * 1024));
---

<div class="field">
  <label for={id} class="field__label">
    {label} <span class="field__optional">(optional)</span>
  </label>
  <input
    id={id}
    name={name}
    type="file"
    multiple
    accept={ALLOWED_FILE_EXTENSIONS.join(",")}
    class="field__file"
    aria-describedby={`${id}-hint ${id}-error`}
  />
  <p id={`${id}-hint`} class="field__hint">
    Fotos (JPG, PNG, WEBP) oder PDF, je max. {maxSizeMb} MB, bis zu {MAX_FILES} Dateien.
  </p>
  <ul id={`${id}-filelist`} class="field__filelist"></ul>
  <p id={`${id}-error`} class="field__error" role="alert"></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .field__optional {
    font-weight: 400;
    color: var(--color-simin-blue);
  }

  .field__file {
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .field__hint {
    font-size: 0.8125rem;
    color: var(--color-simin-blue);
  }

  .field__filelist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8125rem;
  }

  /* :global() nötig: die <li>-Einträge werden zur Laufzeit per JS erzeugt
     (QuoteWizard.astro) und tragen deshalb NICHT Astros
     Scoping-Attribut - ohne :global() würden diese Regeln nie greifen. */
  :global(.field__filelist-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-ice);
  }

  :global(.field__filelist-name) {
    font-weight: 600;
    color: var(--color-text);
    word-break: break-word;
  }

  :global(.field__filelist-meta) {
    color: var(--color-simin-blue);
    white-space: nowrap;
  }

  :global(.field__filelist-remove) {
    margin-left: auto;
    border: none;
    background: none;
    padding: 2px 4px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-error);
    text-decoration: underline;
    cursor: pointer;
  }

  :global(.field__filelist-remove:hover),
  :global(.field__filelist-remove:focus-visible) {
    color: var(--color-navy);
  }

  :global(.field__filelist-remove:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .field__error {
    font-size: 0.8125rem;
    color: var(--color-error);
    min-height: 1em;
  }

  .field__error:empty {
    display: none;
  }
</style>
