---
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { company } from "@/config/site";
import { withBase } from "@/lib/path";

interface Props {
  eyebrow: string;
  headline: string;
  text: string;
  imageSrc?: string;
  imagePosition?: string;
  /** "final" kennzeichnet den Seitenabschluss-CTA (stärker inszeniert als
   * die funktionalen Zwischen-CTAs auf Unterseiten und im Seitenverlauf). */
  variant?: "default" | "final";
}

const { eyebrow, headline, text, imageSrc, imagePosition, variant = "default" } = Astro.props;
---

<section class:list={["cta-section", { "cta-section--final": variant === "final" }]}>
  <ResponsiveImage
    src={imageSrc}
    alt="Gepflegte Immobilie, betreut von Gebäudedienste SIMIN"
    width={1920}
    height={900}
    class="cta-section__image"
    loading="lazy"
    fill
    objectPosition={imagePosition}
  />
  <div class="cta-section__overlay"></div>
  <div class="container cta-section__content" data-stagger="90">
    <p class="eyebrow eyebrow--orange-on-dark" data-reveal="up">{eyebrow}</p>
    <h2 class="cta-section__headline" set:html={headline.replace(/\n/g, "<br />")} data-reveal="up" />
    <p class="cta-section__text" data-reveal="up">{text}</p>
    <div class="cta-section__actions" data-reveal="up">
      <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
      <a href={company.phone.href} class="btn btn-secondary btn-secondary--on-dark">
        {company.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    color: var(--color-white);
    min-height: 480px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* :global() nötig: .cta-section__image wird als class-Prop an
     ResponsiveImage durchgereicht, das <img> trägt also dessen
     data-astro-cid, nicht das von CTASection.astro - ohne :global() träfe
     dieser Selektor nie (der Hintergrund-Shift der Abschluss-Variante lief
     dadurch nie). */
  :global(.cta-section__image) {
    position: absolute;
    inset: 0;
    height: 100%;
    object-position: center 25%;
  }

  .cta-section__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(7, 53, 74, 0.92) 0%, rgba(7, 53, 74, 0.55) 70%);
  }

  .cta-section--final .cta-section__overlay {
    background:
      linear-gradient(120deg, rgba(7, 53, 74, 0.94) 0%, rgba(7, 53, 74, 0.6) 65%),
      linear-gradient(20deg, rgba(247, 148, 40, 0.28) 0%, rgba(247, 148, 40, 0) 45%);
  }

  .cta-section--final {
    border-top: 4px solid var(--color-orange);
  }

  /* Finaler CTA: langsamer, sichtbarer Hintergrund-Shift statt eines
     statischen Bilds - unterscheidet den Seitenabschluss klar von den
     funktionalen Zwischen-CTAs. */
  html.motion-enabled .cta-section--final :global(.cta-section__image) {
    animation: cta-final-shift 12s var(--ease-standard) forwards;
  }

  @keyframes cta-final-shift {
    from {
      transform: scale(1.06) translateY(0);
    }
    to {
      transform: scale(1) translateY(-10px);
    }
  }

  /* Headline/Text/Button des Abschluss-CTAs bewegen sich deutlicher und
     zeitlich klarer versetzt als bei den mittleren Zwischen-CTAs. */
  html.motion-enabled .cta-section--final .cta-section__headline[data-reveal] {
    transform: translateY(45px);
    transition-duration: 900ms;
    transition-delay: 90ms;
  }

  html.motion-enabled .cta-section--final .cta-section__headline[data-reveal].is-visible {
    transform: none;
  }

  html.motion-enabled .cta-section--final .cta-section__text[data-reveal] {
    transition-delay: 210ms;
  }

  html.motion-enabled .cta-section--final .cta-section__actions[data-reveal] {
    transition-delay: 370ms;
  }

  .cta-section__content {
    position: relative;
    width: 100%;
    min-width: 0;
    padding-block: clamp(64px, 10vw, 120px);
    max-width: 640px;
  }

  .cta-section--final .cta-section__content {
    padding-block: clamp(80px, 12vw, 144px);
    max-width: 680px;
  }

  .cta-section__headline {
    font-size: var(--fs-h2);
    color: var(--color-white);
    margin-top: 12px;
  }

  .cta-section--final .cta-section__headline {
    font-size: var(--fs-h1);
  }

  .cta-section__text {
    margin-top: 20px;
    font-size: var(--fs-lead);
    max-width: 52ch;
  }

  .cta-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }
</style>
