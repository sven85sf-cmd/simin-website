---
import SectionHeader from "@/components/SectionHeader.astro";
import ServicePanel from "@/components/ServicePanel.astro";
import { imagePositions } from "@/lib/imagePositions";

const panels = [
  {
    title: "Gebäudereinigung",
    text: "Saubere und hygienisch gepflegte Räume für Wohn-, Büro-, Praxis- und Gewerbeobjekte.",
    items: ["Büro- & Praxisreinigung", "Treppenhausreinigung", "Unterhaltsreinigung", "Glas- & Fensterreinigung"],
    href: "/gebaeudereinigung-koeln",
    accent: "blue" as const,
    image: "/images/service-gebaeudereinigung.webp",
    imageAlt: "Glasreinigung an einer Fensterfront",
    imagePosition: imagePositions["/images/service-gebaeudereinigung.webp"],
  },
  {
    title: "Objektservice",
    text: "Persönliche Betreuung und regelmäßige Kontrollen für gepflegte Allgemeinflächen und klare Abläufe im Objekt.",
    items: [
      "Objektbetreuung & Kontrollgänge",
      "Kontrolle von Allgemeinflächen",
      "Mülltonnenbereitstellung",
      "Kleinreparaturen im vereinbarten Leistungsumfang",
    ],
    href: "/objektservice-koeln",
    accent: "blue" as const,
    image: "/images/service-objektservice.webp",
    imageAlt: "Kleinreparatur und Objektservice an einer Immobilie",
    imagePosition: imagePositions["/images/service-objektservice.webp"],
  },
  {
    title: "Außenanlagen & Grünflächen",
    text: "Gepflegte Außenbereiche und Grünflächen über das ganze Jahr hinweg.",
    items: ["Rasen- & Rasenkantenpflege", "Heckenschnitt", "Laubbeseitigung", "Hof- & Wegepflege"],
    href: "/aussenanlagenpflege-koeln",
    accent: "orange" as const,
    image: "/images/service-aussenanlagen-gruen.webp",
    imageAlt: "Grünpflege und Außenanlagenpflege an einem gepflegten Objekt",
    imagePosition: imagePositions["/images/service-aussenanlagen-gruen.webp"],
  },
  {
    title: "Winterdienst",
    text: "Saisonale Betreuung von Wegen und Einfahrten bei Schnee und Glätte.",
    items: ["Räumen von Wegen & Einfahrten", "Streudienst bei Schnee & Glätte", "Kontrollgänge bei winterlicher Witterung"],
    href: "/winterdienst-koeln",
    accent: "orange" as const,
    image: "/images/service-winterdienst.webp",
    imageAlt: "Winterdienst auf einem verschneiten Weg",
    imagePosition: imagePositions["/images/service-winterdienst.webp"],
  },
];
---

<section class="services-section section" id="leistungen">
  <div class="container">
    <SectionHeader
      eyebrow="UNSERE LEISTUNGEN"
      headline="ALLES, WAS IHRE IMMOBILIE GEPFLEGT HÄLT."
      text="Ob regelmäßige Reinigung, laufende Objektbetreuung oder Pflege der Außenanlagen: Wir bündeln wichtige Gebäudedienstleistungen und schaffen klare Zuständigkeiten."
    />
    <div class="services-section__list">
      {panels.map((panel, index) => (
        <ServicePanel {...panel} reversed={index % 2 === 1} />
      ))}
    </div>
  </div>
</section>

<style>
  .services-section__list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
</style>
