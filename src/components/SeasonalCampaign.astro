---
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { seasonalCampaign } from "@/config/site";
import { withBase } from "@/lib/path";
---

{
  seasonalCampaign.active && (
    <section class="seasonal section">
      <div class="container seasonal__grid reveal">
        <div class="seasonal__media">
          <ResponsiveImage
            src="/images/service-aussenanlagen.webp"
            alt="Herbstliche Laubbeseitigung auf einem gepflegten Grundstück"
            width={1200}
            height={1566}
            class="seasonal__image"
          />
        </div>
        <div class="seasonal__body">
          <p class="eyebrow eyebrow--orange">{seasonalCampaign.eyebrow}</p>
          <h2 class="seasonal__headline" set:html={seasonalCampaign.headline.replace(/\n/g, "<br />")} />
          <p class="prose">{seasonalCampaign.text}</p>
          <ul class="seasonal__keywords">
            {seasonalCampaign.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
          <p class="seasonal__claim" set:html={seasonalCampaign.claim.replace(/\n/g, "<br />")} />
          <div class="seasonal__actions">
            <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
            <a href={withBase(seasonalCampaign.href)} class="btn-ghost">MEHR ERFAHREN</a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .seasonal {
    background: linear-gradient(160deg, var(--color-navy) 0%, var(--color-simin-blue) 100%);
    color: var(--color-white);
  }

  .seasonal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  .seasonal__grid > * {
    min-width: 0;
  }

  .seasonal__image {
    border-radius: var(--radius-lg);
  }

  .seasonal__headline {
    font-size: var(--fs-h2);
    color: var(--color-white);
    margin-top: 10px;
  }

  .seasonal__keywords {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block: 16px;
  }

  .seasonal__keywords li {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
  }

  .seasonal__claim {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-orange);
    margin-block: 8px;
  }

  .seasonal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .seasonal__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
