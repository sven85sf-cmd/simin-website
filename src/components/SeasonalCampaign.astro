---
import { seasonalCampaign } from "@/config/site";
import { withBase } from "@/lib/path";
---

{
  seasonalCampaign.active && (
    <section class="seasonal section">
      <div class="container seasonal__grid">
        <div class="seasonal__media" data-reveal="up">
          <video
            class="seasonal__video"
            poster={withBase("/images/seasonal-video-poster.webp")}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
            data-lazy-video
          >
            <source data-src={withBase("/videos/herbst-winter-mobile.mp4")} media="(max-width: 767px)" type="video/mp4" />
            <source data-src={withBase("/videos/herbst-winter-desktop.mp4")} type="video/mp4" />
          </video>
        </div>
        <div class="seasonal__body" data-reveal="up">
          <p class="eyebrow eyebrow--orange">{seasonalCampaign.eyebrow}</p>
          <h2 class="seasonal__headline" set:html={seasonalCampaign.headline.replace(/\n/g, "<br />")} />
          <p class="prose">{seasonalCampaign.text}</p>
          <ul class="seasonal__keywords">
            {seasonalCampaign.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
          <p class="seasonal__claim" set:html={seasonalCampaign.claim.replace(/\n/g, "<br />")} />
          <div class="seasonal__actions">
            <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
            <a href={withBase(seasonalCampaign.href)} class="btn-ghost">MEHR ERFAHREN</a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .seasonal {
    background: linear-gradient(160deg, var(--color-navy) 0%, var(--color-simin-blue) 100%);
    color: var(--color-white);
  }

  .seasonal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  .seasonal__grid > * {
    min-width: 0;
  }

  .seasonal__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .seasonal__video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-lg);
    background: var(--color-navy);
  }

  /* Cinematisches Kampagnenmodul: Video-Panel bekommt einen spürbaren
     Zoom-Reveal (1.06 -> 1) als die übrigen Sections, Text folgt leicht
     zeitversetzt. */
  html.motion-enabled .seasonal__media[data-reveal] .seasonal__video {
    transform: scale(1.06);
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  html.motion-enabled .seasonal__media[data-reveal].is-visible .seasonal__video {
    transform: scale(1);
  }

  html.motion-enabled .seasonal__body[data-reveal] {
    transition-delay: 140ms;
  }

  .seasonal__headline {
    font-size: var(--fs-h2);
    color: var(--color-white);
    margin-top: 10px;
  }

  .seasonal__keywords {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block: 16px;
  }

  .seasonal__keywords li {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
  }

  .seasonal__claim {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-orange);
    margin-block: 8px;
  }

  .seasonal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .seasonal__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  /**
   * Saisonvideo: lädt und startet erst, wenn das Panel in die Nähe des
   * Viewports kommt (kein eager Preload/Autoplay direkt beim Laden der
   * Seite), und nur wenn prefers-reduced-motion nicht aktiv ist - dann
   * bleibt es beim statischen Poster-Bild. Kein Ton, keine Controls
   * (rein visuelles Markenmedium), stiller Fallback auf das Poster, falls
   * play() vom Browser abgelehnt wird.
   */
  const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
  const video = document.querySelector<HTMLVideoElement>("[data-lazy-video]");

  if (video && !reduceMotion) {
    const start = () => {
      video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((source) => {
        source.src = source.dataset.src ?? "";
      });
      video.muted = true;
      video.load();
      video.play().catch(() => {
        /* Autoplay abgelehnt (z. B. Sparmodus) - Poster bleibt sichtbar. */
      });
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              start();
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "200px 0px" },
      );
      observer.observe(video);
    } else {
      start();
    }
  }
</script>
