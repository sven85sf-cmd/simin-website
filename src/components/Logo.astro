---
/**
 * Logo-Komponente.
 *
 * FORENSISCH BEWIESENER ROOT CAUSE (siehe Commit-Historie/Abschlussbericht):
 * Ein per `astro:assets` statisch importiertes, lokales Bild, das
 * AUSSCHLIESSLICH aus serverseitig gerenderten, nicht client-hydrierten,
 * nicht vorgerenderten Komponenten heraus verwendet wird (exakt der Fall
 * hier: Logo.astro wird nur von Header/Footer/Hero verwendet, alle rein
 * SSR, kein `client:*`, keine dieser Seiten setzt `prerender = true`),
 * landet im Wix/Cloudflare-Adapter-Build NICHT im öffentlichen
 * Client-Asset-Ordner (`dist/_astro/`), sondern nur im Server-Worker-
 * Bundle selbst (`dist/_worker.js/_astro/...`). Die im HTML erzeugte
 * `<img src="/_astro/<hash>.png">`-URL zeigt dadurch auf einen Pfad, den
 * das Hosting öffentlich gar nicht ausliefert -> 404 -> der Browser
 * rendert stattdessen den `alt`-Text ("Gebäudedienste SIMIN"), was exakt
 * dem beobachteten Text-Fallback in Header UND Hero entspricht (beide
 * nutzen dieselbe Komponente).
 *
 * Das Hero-HINTERGRUNDBILD ist von diesem Bug nicht betroffen, weil es
 * (über ResponsiveImage.astro) einen normalen `public/`-Pfad als String
 * verwendet, NICHT astro:assets - genau dieses bewährte, nachweislich
 * funktionierende Muster wird hier für das Logo übernommen: das
 * unveränderte Original-Logo liegt zusätzlich (Original in
 * src/assets/logo/simin-logo.png bleibt bestehen) unter
 * public/brand/simin-logo.png (SHA256-identisch) und wird als einfacher,
 * deterministischer <img>-Pfad referenziert. `public/` wird von
 * Astro IMMER unverändert 1:1 in den Root des Build-Outputs kopiert,
 * unabhängig von SSR/Client-Rendering-Kontext - dadurch ist die
 * öffentliche Erreichbarkeit garantiert, nicht nur vermutet.
 */
import { company } from "@/config/site";
import { withBase } from "@/lib/path";

interface Props {
  variant?: "light" | "dark";
  size?: "header" | "footer" | "hero";
  class?: string;
  "data-reveal"?: string;
}

const {
  size = "header",
  class: className = "",
  "data-reveal": dataReveal,
} = Astro.props;
---

<a
  href={withBase("/")}
  class={`logo logo--badge logo--badge-${size} ${className}`}
  aria-label={`${company.name} – Startseite`}
  data-reveal={dataReveal}
>
  <img src={withBase("/brand/simin-logo.png")} alt={company.name} width="240" height="201" />
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    gap: 2px;
  }

  .logo--badge {
    flex-direction: row;
    align-items: center;
  }

  .logo--badge :global(img) {
    width: auto;
    display: block;
  }

  .logo--badge-header :global(img) {
    height: clamp(78px, 10.5vw, 104px);
  }

  .logo--badge-footer :global(img) {
    height: clamp(112px, 15vw, 184px);
  }

  .logo--badge-hero :global(img) {
    height: clamp(88px, 9vw, 136px);
  }
</style>
