---
/**
 * Logo-Komponente.
 *
 * Verwendet das originale SIMIN-Logo (extrahiert aus dem freigegebenen
 * Herbst/Winter-Flyer-PDF, src/assets/logo/simin-logo.png) über einen
 * statischen Import - das Asset ist damit die alleinige, deterministische
 * Quelle. Bewusst KEIN import.meta.glob mehr: dessen Auflösung war im
 * Wix-Build nicht zuverlässig, wodurch überall (Header UND Footer, die
 * beide diese Komponente verwenden) stattdessen der - inzwischen ebenfalls
 * entfernte - typografische Fallback gerendert wurde. Fehlt die
 * Logo-Datei künftig wirklich, soll der Build fehlschlagen statt eines
 * stillen Ersatzlogos.
 */
import { Image } from "astro:assets";
import { company } from "@/config/site";
import { withBase } from "@/lib/path";
import siminLogo from "@/assets/logo/simin-logo.png";

interface Props {
  variant?: "light" | "dark";
  size?: "header" | "footer" | "hero";
  class?: string;
  "data-reveal"?: string;
}

const {
  size = "header",
  class: className = "",
  "data-reveal": dataReveal,
} = Astro.props;
---

<a
  href={withBase("/")}
  class={`logo logo--badge logo--badge-${size} ${className}`}
  aria-label={`${company.name} – Startseite`}
  data-reveal={dataReveal}
>
  <Image src={siminLogo} alt={company.name} width={240} height={201} />
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    gap: 2px;
  }

  .logo--badge {
    flex-direction: row;
    align-items: center;
  }

  .logo--badge :global(img) {
    width: auto;
    display: block;
  }

  .logo--badge-header :global(img) {
    height: clamp(78px, 10.5vw, 104px);
  }

  .logo--badge-footer :global(img) {
    height: clamp(112px, 15vw, 184px);
  }

  .logo--badge-hero :global(img) {
    height: clamp(88px, 9vw, 136px);
  }
</style>
