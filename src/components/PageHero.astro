---
import ResponsiveImage from "@/components/ResponsiveImage.astro";

interface Props {
  eyebrow: string;
  headline: string;
  text?: string;
  placeholderLabel?: string;
  src?: string;
  imagePosition?: string;
  /** Aktiviert das Reveal-System (siehe global.css/BaseLayout.astro) für
   * Eyebrow/H1/Text. Standardmäßig aus, damit bestehende Seiten (z. B.
   * /ueber-uns, /herbst-winter), die PageHero ohne Motion nutzen, optisch
   * unverändert bleiben. */
  reveal?: boolean;
}

const { eyebrow, headline, text, placeholderLabel, src, imagePosition, reveal = false } = Astro.props;

// Längstes Wort (in Zeichen) begrenzt die Schriftgröße, damit kein Begriff
// umbrochen oder getrennt werden muss (siehe .page-hero__headline).
const longestWord = Math.max(...headline.split(/\s+/).map((word) => Array.from(word).length));
---

<section class="page-hero">
  <div class="page-hero__media">
    <ResponsiveImage
      src={src}
      alt={headline}
      width={1600}
      height={900}
      loading="eager"
      fetchpriority="high"
      class="page-hero__image"
      placeholderLabel={placeholderLabel ?? "Titelbild — Originalfoto folgt"}
      fill
      objectPosition={imagePosition}
    />
    <div class="page-hero__gradient" aria-hidden="true"></div>
  </div>
  <div class="container page-hero__content" data-stagger={reveal ? "120" : undefined}>
    <p class="eyebrow eyebrow--orange-on-dark" data-reveal={reveal ? "up" : undefined}>{eyebrow}</p>
    <h1
      class="page-hero__headline"
      style={`--hero-longest-word: ${longestWord}`}
      data-reveal={reveal ? "up" : undefined}
    >
      {headline}
    </h1>
    {text && <p class="page-hero__text" data-reveal={reveal ? "up" : undefined}>{text}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(320px, 46vw, 480px);
    color: var(--color-white);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__image {
    height: 100%;
    object-position: center 22%;
  }

  .page-hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(7, 53, 74, 0.92) 0%, rgba(7, 53, 74, 0.55) 60%, rgba(7, 53, 74, 0.15) 100%);
  }

  .page-hero__content {
    position: relative;
    width: 100%;
    min-width: 0;
    padding-block: 48px;
    max-width: 880px;
    container-type: inline-size;
  }

  /* Deutsche Komposita ("Hausmeisterservice", "Gebäudedienstleistungen")
     werden nie getrennt: keine automatische Silbentrennung, stattdessen
     wird die Schrift so begrenzt, dass das längste Wort in die Textbreite
     passt. 0.43em ≈ gemessene Durchschnittsbreite pro Zeichen von Barlow
     Condensed 700 (0.39–0.42em) plus Reserve. */
  .page-hero__headline {
    font-size: var(--fs-h1);
    font-size: min(var(--fs-h1), calc(100cqi / (var(--hero-longest-word) * 0.43)));
    color: var(--color-white);
    margin-top: 12px;
    hyphens: manual;
  }

  .page-hero__text {
    margin-top: 18px;
    font-size: var(--fs-lead);
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.92);
  }
</style>
