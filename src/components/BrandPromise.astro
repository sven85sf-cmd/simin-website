---
import SectionHeader from "@/components/SectionHeader.astro";
import { Image } from "astro:assets";

const logoImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/logo/simin-logo.{png,svg,webp}",
  { eager: true },
);
const logoEntry = Object.values(logoImages)[0];
---

<section class="brand-promise section--tight">
  {
    logoEntry && (
      <Image
        src={logoEntry.default}
        alt=""
        width={900}
        height={753}
        class="brand-promise__seal"
        aria-hidden="true"
      />
    )
  }
  <div class="container brand-promise__grid reveal">
    <SectionHeader
      eyebrow="GEBÄUDEDIENSTLEISTUNGEN MIT PERSÖNLICHER BETREUUNG"
      headline="DAMIT IHRE IMMOBILIE\nDAUERHAFT EINEN GEPFLEGTEN\nEINDRUCK MACHT."
    />
    <div class="brand-promise__body">
      <p class="prose">
        Eine gepflegte Immobilie entsteht nicht durch einzelne Leistungen, sondern durch
        zuverlässige Abläufe und einen Ansprechpartner, der den Überblick behält.
      </p>
      <p class="prose">
        Gebäudedienste SIMIN übernimmt Leistungen rund um Reinigung, Objektbetreuung,
        Außenanlagen und saisonalen Winterdienst – abgestimmt auf Ihr Objekt und Ihren
        tatsächlichen Bedarf.
      </p>
      <a href="/ueber-uns" class="btn-ghost brand-promise__link">SIMIN KENNENLERNEN</a>
    </div>
  </div>
</section>

<style>
  .brand-promise {
    position: relative;
    overflow: hidden;
  }

  .brand-promise__seal {
    position: absolute;
    top: 50%;
    right: -6%;
    transform: translateY(-50%);
    width: clamp(360px, 42vw, 620px);
    height: auto;
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
  }

  .brand-promise__grid {
    position: relative;
    z-index: 1;
  }

  .brand-promise__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .brand-promise__grid > * {
    min-width: 0;
  }

  .brand-promise :global(.section-header) {
    margin-bottom: 0;
  }

  .brand-promise__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .brand-promise__link {
    margin-top: 4px;
  }

  @media (min-width: 1024px) {
    .brand-promise__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
  }
</style>
