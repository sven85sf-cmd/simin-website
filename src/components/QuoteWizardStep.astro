---
interface Props {
  step: number;
  legend: string;
  hidden?: boolean;
}

const { step, legend, hidden = false } = Astro.props;
---

<fieldset class="quote-wizard__step" data-step={step} hidden={hidden}>
  <legend class="quote-wizard__legend" tabindex="-1">{legend}</legend>
  <div class="quote-wizard__step-body">
    <slot />
  </div>
</fieldset>

<style>
  .quote-wizard__step {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Step-Übergang: kurzer, ruhiger Slide + Fade beim Wechsel zwischen
     Schritten (siehe QuoteWizard.astro-Skript). Kein Layout-Sprung, da
     nur transform/opacity animiert werden. */
  html.motion-enabled .quote-wizard__step {
    transition:
      opacity var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-standard);
  }

  html.motion-enabled .quote-wizard__step--entering {
    opacity: 0;
    transform: translateX(16px);
  }

  .quote-wizard__legend {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-navy);
    padding: 0;
    outline: none;
  }

  .quote-wizard__step-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
</style>
