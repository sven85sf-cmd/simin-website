---
import Logo from "@/components/Logo.astro";
import { company, footerNav } from "@/config/site";
import { withBase } from "@/lib/path";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <div class="site-footer__brand-mark" data-stagger="120">
        <Logo variant="light" size="footer" data-reveal="up" />
        <p class="site-footer__claim" data-reveal="up">{company.claim}</p>
      </div>
      <address class="site-footer__contact">
        <span>{company.address.street}</span>
        <span>{company.address.postalCode} {company.address.city}</span>
        <a href={company.phone.href}>{company.phone.display}</a>
        <a href={company.email.href}>{company.email.display}</a>
        <a href={company.url} rel="noopener">www.gebaeudedienste-simin.de</a>
        <div class="site-footer__hours">
          <span class="site-footer__hours-heading">Bürozeiten</span>
          <span>Montag–Freitag</span>
          <span>08:00–16:00 Uhr</span>
          <span>Samstag</span>
          <span>09:00–13:00 Uhr</span>
        </div>
      </address>
    </div>

    <nav class="site-footer__col" aria-label="Leistungen">
      <h2 class="site-footer__heading">Leistungen</h2>
      <ul>
        {footerNav.leistungen.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Unternehmen">
      <h2 class="site-footer__heading">Unternehmen</h2>
      <ul>
        {footerNav.unternehmen.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Service">
      <h2 class="site-footer__heading">Service</h2>
      <ul>
        {footerNav.service.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="site-footer__bottom container">
    <span>&copy; {year} {company.name.toUpperCase()}</span>
    <ul class="site-footer__legal">
      {footerNav.legal.map((item) => (
        <li><a href={withBase(item.href)}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: var(--color-white);
    padding-top: clamp(48px, 6vw, 80px);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .site-footer__grid > * {
    min-width: 0;
  }

  .site-footer__brand-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .site-footer__claim {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    color: var(--color-light-blue);
    max-width: 26ch;
  }

  .site-footer__contact {
    font-style: normal;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    margin-top: 24px;
    font-size: 0.9375rem;
  }

  .site-footer__contact a {
    color: var(--color-white);
    text-decoration: none;
  }

  .site-footer__contact a:hover {
    color: var(--color-orange);
  }

  .site-footer__hours {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-top: 14px;
  }

  .site-footer__hours-heading {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-light-blue);
    margin-bottom: 4px;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-light-blue);
    margin-bottom: 16px;
  }

  .site-footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__col a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .site-footer__col a:hover {
    color: var(--color-orange);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    padding-block: 20px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .site-footer__legal {
    list-style: none;
    display: flex;
    gap: 20px;
  }

  .site-footer__legal a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--color-orange);
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }
  }

  /* Unterhalb 1200px blendet StickyMobileBar.astro eine fixe Bottom-Bar
     ein (siehe --sticky-bar-height dort); ohne Ausgleich verdeckt sie das
     Footer-Ende (Copyright/Impressum/Datenschutz). Extra-Abstand exakt in
     Höhe der Bar zzgl. Safe-Area, damit beide Werte nicht auseinanderlaufen
     können, falls die Bar responsive höher wird. */
  @media (max-width: 1199px) {
    .site-footer {
      padding-bottom: calc(var(--sticky-bar-height) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
