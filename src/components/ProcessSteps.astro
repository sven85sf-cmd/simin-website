---
import SectionHeader from "@/components/SectionHeader.astro";

const steps = [
  {
    number: "01",
    title: "ANFRAGE",
    text: "Sie teilen uns mit, welche Leistungen Sie benötigen und um welches Objekt es geht.",
  },
  {
    number: "02",
    title: "BEDARF",
    text: "Wir besprechen Leistungsumfang, Anforderungen und Besonderheiten Ihres Objekts.",
  },
  {
    number: "03",
    title: "ANGEBOT",
    text: "Sie erhalten ein auf den vereinbarten Leistungsumfang abgestimmtes Angebot.",
  },
  {
    number: "04",
    title: "START",
    text: "Nach Beauftragung koordinieren wir den vereinbarten Start und die laufende Leistungserbringung.",
  },
];
---

<section class="process section--ice section">
  <div class="container">
    <SectionHeader
      eyebrow="UNSERE ZUSAMMENARBEIT"
      headline="VON DER ANFRAGE\nBIS ZUR LAUFENDEN BETREUUNG."
    />
    <ol class="process__list reveal">
      {steps.map((step, index) => (
        <li class="process__item">
          <div class="process__marker">
            <span class="process__number">{step.number}</span>
            {index < steps.length - 1 && <span class="process__line" aria-hidden="true" />}
          </div>
          <div class="process__body">
            <h3 class="process__title">{step.title}</h3>
            <p class="prose">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="process__cta">
      <a href="/angebot" class="btn btn-primary">ANGEBOT ANFRAGEN</a>
    </div>
  </div>
</section>

<style>
  .process__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process__item {
    display: flex;
    gap: 20px;
  }

  .process__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .process__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .process__line {
    width: 2px;
    flex: 1;
    background: var(--color-border);
    margin-block: 4px;
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.8s var(--ease-standard);
  }

  .process__list.is-visible .process__line {
    transform: scaleY(1);
  }

  .process__body {
    padding-bottom: 40px;
  }

  .process__title {
    font-size: 1.25rem;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }

  .process__cta {
    margin-top: 16px;
  }

  @media (min-width: 1024px) {
    .process__list {
      flex-direction: row;
    }

    .process__item {
      flex-direction: column;
      flex: 1;
    }

    .process__marker {
      flex-direction: row;
      width: 100%;
    }

    .process__line {
      width: auto;
      height: 2px;
      flex: 1;
      margin-block: 0;
      margin-inline: 4px;
      transform-origin: left;
      transform: scaleX(0);
      transition: transform 0.8s var(--ease-standard);
    }

    .process__list.is-visible .process__line {
      transform: scaleX(1);
    }

    .process__body {
      padding-right: 16px;
    }
  }
</style>
