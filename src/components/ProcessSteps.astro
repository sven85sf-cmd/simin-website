---
import SectionHeader from "@/components/SectionHeader.astro";
import { withBase } from "@/lib/path";

const steps = [
  {
    number: "01",
    title: "ANFRAGE",
    text: "Sie teilen uns mit, welche Leistungen Sie benötigen und um welches Objekt es geht.",
  },
  {
    number: "02",
    title: "BEDARF",
    text: "Wir besprechen Leistungsumfang, Anforderungen und Besonderheiten Ihres Objekts.",
  },
  {
    number: "03",
    title: "ANGEBOT",
    text: "Sie erhalten ein auf den vereinbarten Leistungsumfang abgestimmtes Angebot.",
  },
  {
    number: "04",
    title: "START",
    text: "Nach Beauftragung koordinieren wir den vereinbarten Start und die laufende Leistungserbringung.",
  },
];
---

<section class="process section--ice section">
  <div class="container">
    <SectionHeader
      eyebrow="UNSERE ZUSAMMENARBEIT"
      headline="VON DER ANFRAGE\nBIS ZUR LAUFENDEN BETREUUNG."
    />
    <ol class="process__list" data-reveal="up">
      {steps.map((step, index) => (
        <li class="process__item">
          <div class="process__marker">
            <span class="process__number">{step.number}</span>
            {index < steps.length - 1 && <span class="process__line" aria-hidden="true" />}
          </div>
          <div class="process__body">
            <h3 class="process__title">{step.title}</h3>
            <p class="prose">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="process__cta">
      <a href={withBase("/angebot")} class="btn btn-primary">ANGEBOT ANFRAGEN</a>
    </div>
  </div>
</section>

<style>
  .process__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process__item {
    display: flex;
    gap: 20px;
  }

  .process__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .process__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  /* Stärkster Motion-Moment der Seite: die Linie "zeichnet" sich Schritt
     für Schritt, jede Nummer aktiviert sich sichtbar (Skalierung, Opazität
     UND Farbwechsel), sobald die Linie sie erreicht. Einmalig, wenn die
     Section in den Viewport kommt. */
  html.motion-enabled .process__number {
    transform: scale(0.96);
    opacity: 0.55;
    background-color: var(--color-light-blue);
    transition:
      transform var(--motion-base) var(--ease-standard),
      opacity var(--motion-base) var(--ease-standard),
      background-color var(--motion-base) var(--ease-standard);
  }

  html.motion-enabled .process__list.is-visible .process__number {
    transform: scale(1);
    opacity: 1;
    background-color: var(--color-navy);
  }

  html.motion-enabled .process__list.is-visible .process__item:nth-child(2) .process__number {
    transition-delay: 0.6s;
  }

  html.motion-enabled .process__list.is-visible .process__item:nth-child(3) .process__number {
    transition-delay: 1.2s;
  }

  html.motion-enabled .process__list.is-visible .process__item:nth-child(4) .process__number {
    transition-delay: 1.8s;
  }

  .process__line {
    width: 3px;
    flex: 1;
    background: var(--color-simin-blue);
    margin-block: 4px;
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.6s var(--ease-standard);
  }

  .process__list.is-visible .process__line {
    transform: scaleY(1);
  }

  .process__list.is-visible .process__item:nth-child(1) .process__line {
    transition-delay: 0.15s;
  }

  .process__list.is-visible .process__item:nth-child(2) .process__line {
    transition-delay: 0.75s;
  }

  .process__list.is-visible .process__item:nth-child(3) .process__line {
    transition-delay: 1.35s;
  }

  .process__body {
    padding-bottom: 40px;
  }

  .process__title {
    font-size: 1.25rem;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }

  .process__cta {
    margin-top: 16px;
  }

  @media (min-width: 1024px) {
    .process__list {
      flex-direction: row;
    }

    .process__item {
      flex-direction: column;
      flex: 1;
    }

    .process__marker {
      flex-direction: row;
      width: 100%;
    }

    .process__line {
      width: auto;
      height: 3px;
      flex: 1;
      margin-block: 0;
      margin-inline: 4px;
      transform-origin: left;
      transform: scaleX(0);
      transition: transform 0.8s var(--ease-standard);
    }

    .process__list.is-visible .process__line {
      transform: scaleX(1);
    }

    .process__body {
      padding-right: 16px;
    }
  }
</style>
