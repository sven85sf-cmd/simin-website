---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Seite nicht gefunden | Gebäudedienste SIMIN";
const description = "Diese Seite ist nicht mehr hier. Zurück zu Gebäudedienste SIMIN.";
---

<BaseLayout title={title} description={description} path="/404" noindex>
  <section class="section not-found">
    <div class="container not-found__content">
      <p class="eyebrow eyebrow--orange">404</p>
      <h1>DIESE SEITE IST NICHT MEHR HIER.</h1>
      <p class="lead">Zurück zu Gebäudedienste SIMIN.</p>
      <div class="not-found__actions">
        <a href="/" class="btn btn-primary">ZUR STARTSEITE</a>
        <a href="/angebot" class="btn-ghost">ANGEBOT ANFRAGEN</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60svh;
    display: flex;
    align-items: center;
  }

  .not-found__content {
    width: 100%;
    min-width: 0;
    max-width: 560px;
  }

  .not-found h1 {
    font-size: var(--fs-h2);
    margin-top: 12px;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    margin-top: 28px;
  }
</style>
