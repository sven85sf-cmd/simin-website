---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { company } from "@/config/site";

const title = "Datenschutzerklärung | Gebäudedienste SIMIN";
const description = "Datenschutzerklärung von Gebäudedienste SIMIN.";
---

<BaseLayout title={title} description={description} path="/datenschutz" noindex>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Datenschutz", href: "/datenschutz" }]} />

  <section class="section legal">
    <div class="container legal__content prose">
      <p class="legal__notice" role="note">
        RECHTSTEXT VOR LIVEGANG PRÜFEN — Diese Datenschutzerklärung ist ein struktureller
        Platzhalter auf Basis der bestätigten Unternehmensangaben. Sie muss vor Livegang mit der
        finalen, rechtlich geprüften Datenschutzerklärung abgeglichen bzw. ersetzt werden
        (insbesondere Angaben zu eingesetzten Diensten, Auftragsverarbeitern und Rechtsgrundlagen).
      </p>

      <h1>Datenschutzerklärung</h1>

      <h2>Verantwortlicher</h2>
      <p>
        {company.legalName}<br />
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}<br />
        E-Mail: <a href={company.email.href}>{company.email.display}</a><br />
        Telefon: <a href={company.phone.href}>{company.phone.display}</a>
      </p>

      <h2>Verarbeitung Ihrer Angebotsanfrage</h2>
      <p>
        Wenn Sie über den Angebotsassistenten oder ein Kontaktformular eine Anfrage stellen,
        verarbeiten wir die von Ihnen angegebenen Daten (z. B. Name, Kontaktdaten, Angaben zu
        Ihrem Objekt sowie ggf. hochgeladene Dateien) ausschließlich zur Bearbeitung Ihrer
        Anfrage und zur Kontaktaufnahme.
      </p>

      <h2>Hosting und technische Verarbeitung</h2>
      <p>
        Beim Aufruf dieser Website werden aus technischen Gründen automatisch Informationen in
        Server-Logdateien gespeichert, die Ihr Browser übermittelt. Diese Website bindet derzeit
        keine externen Analyse- oder Tracking-Dienste ein.
      </p>

      <h2>Ihre Rechte</h2>
      <p>
        Sie haben das Recht auf Auskunft, Berichtigung, Löschung und Einschränkung der
        Verarbeitung Ihrer personenbezogenen Daten sowie ein Beschwerderecht bei der zuständigen
        Aufsichtsbehörde.
      </p>

      <h2>Kontakt zum Datenschutz</h2>
      <p>
        Bei Fragen zum Datenschutz wenden Sie sich bitte an{" "}
        <a href={company.email.href}>{company.email.display}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal__notice {
    background: var(--color-cream);
    border: 1px solid var(--color-orange);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-orange-accessible);
    margin-bottom: 32px;
  }

  .legal__content h2 {
    font-size: var(--fs-h3);
    margin-top: 28px;
    margin-bottom: 8px;
  }
</style>
