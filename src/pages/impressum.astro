---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { company } from "@/config/site";

const title = "Impressum | Gebäudedienste SIMIN";
const description = "Impressum von Gebäudedienste SIMIN, Gilgaustraße 64, 51149 Köln.";
---

<BaseLayout title={title} description={description} path="/impressum" noindex>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Impressum", href: "/impressum" }]} />

  <section class="section legal">
    <div class="container legal__content prose">
      <h1>Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {company.legalName}<br />
        {company.legalForm}<br />
        Inhaber: {company.ownerName}<br />
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}<br />
        {company.address.country}
      </p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href={company.phone.href}>{company.phone.display}</a><br />
        E-Mail: <a href={company.email.href}>{company.email.display}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal__content h2 {
    font-size: var(--fs-h3);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .legal__content p {
    margin-bottom: 4px;
  }
</style>
