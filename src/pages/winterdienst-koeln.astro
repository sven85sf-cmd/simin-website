---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServicePageContent from "@/components/ServicePageContent.astro";
import { getServiceBySlug } from "@/data/services";

const service = getServiceBySlug("winterdienst-koeln")!;
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} path="/winterdienst-koeln">
  <ServicePageContent service={service} />
</BaseLayout>
