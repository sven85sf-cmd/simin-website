# Formular-Backend (Angebotsassistent)
# In der Entwicklung wird automatisch der Mock-Adapter verwendet (siehe
# src/lib/forms/submissionService.ts). Für den Produktivbetrieb muss ein
# echter Mail-/Backend-Dienst konfiguriert werden.
#
# Beispiel für einen SMTP-basierten Versand (noch zu konfigurieren):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
QUOTE_REQUEST_TO_EMAIL=kontakt@gebaeudedienste-simin.de

# Rate Limiting (einfacher In-Memory-Schutz, für Produktivbetrieb ggf. durch
# einen persistenten Speicher ersetzen, z. B. Redis)
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
