# Formular-Backend (Angebotsassistent) – Wix-native
#
# Die Angebotsanfrage wird serverseitig als Eintrag in einer Wix-Data-
# Collection gespeichert (siehe src/lib/wix/submissionsRepository.ts).
# Die Benachrichtigung an SIMIN erfolgt NICHT durch diesen Code, sondern
# durch eine im Wix-Dashboard konfigurierte Automation (Trigger: neuer
# Eintrag in dieser Collection → E-Mail an kontakt@gebaeudedienste-simin.de).
#
# Ohne WIX_SUBMISSIONS_COLLECTION_ID antwortet /api/quote klar als "nicht
# konfiguriert" – kein falsches Erfolgssignal.

# ID der Wix-Data-Collection, in die Angebotsanfragen geschrieben werden.
# Muss im Wix-Dashboard (Content Manager) angelegt sein, bevor diese
# Variable gesetzt wird. Empfohlener Anzeigename: "SIMIN Angebotsanfragen".
WIX_SUBMISSIONS_COLLECTION_ID=

# Rate Limiting (einfacher In-Memory-Schutz je Serverinstanz; für einen
# horizontal skalierten Produktivbetrieb durch einen persistenten,
# gemeinsam genutzten Speicher ersetzen, z. B. Redis)
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
