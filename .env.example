# Formular-Backend (Angebotsassistent)
#
# Ohne vollständige Konfiguration reagiert die Route /api/quote klar als
# "nicht konfiguriert" (kein Versand, kein falsches Erfolgssignal) – siehe
# src/lib/mail/getMailService.ts und src/lib/forms/submissionService.ts.
#
# MAIL_PROVIDER steuert den Adapter:
#   - "resend"  → Produktivbetrieb über die Resend-API (empfohlen)
#   - "dev-log" → nur für lokale Entwicklung, protokolliert statt zu senden;
#                 wird in einem Production-Build ignoriert (nie automatischer
#                 Mock-Fallback)
MAIL_PROVIDER=

# Nur für MAIL_PROVIDER=resend erforderlich. Echten Key niemals committen.
RESEND_API_KEY=

# Absenderadresse für den Mailversand, z. B.:
#   "Gebäudedienste SIMIN Website <anfrage@gebaeudedienste-simin.de>"
# Muss beim gewählten Mailprovider als verifizierte Domain/Adresse
# hinterlegt sein, bevor der Versand tatsächlich funktioniert.
MAIL_FROM=

# Empfänger aller Angebotsanfragen. Fällt ohne Angabe auf die in
# src/config/site.ts hinterlegte Adresse zurück.
QUOTE_REQUEST_TO_EMAIL=kontakt@gebaeudedienste-simin.de

# Optionale sachliche Empfangsbestätigung an den Interessenten (Standard: aus).
QUOTE_CONFIRMATION_EMAIL_ENABLED=false

# Rate Limiting (einfacher In-Memory-Schutz je Serverinstanz; für einen
# horizontal skalierten Produktivbetrieb durch einen persistenten,
# gemeinsam genutzten Speicher ersetzen, z. B. Redis)
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
